# =============================================================================
# TICKVERE (https://tickvere.com) - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development. Never commit live secrets.
# =============================================================================

# SUPABASE CLIENT CONFIGURATION (Reached by Browser)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# SUPABASE SERVER CONFIGURATION (Serverless /api functions only)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# CLOUDFLARE TURNSTILE BOT PROTECTION
VITE_TURNSTILE_SITE_KEY="your-turnstile-site-key-here"
TURNSTILE_SECRET_KEY="your-turnstile-secret-key-here"

# DERIV OFFICIAL WEBSOCKET APP ID
# Register your application at https://api.deriv.com or leave default (1089)
VITE_DERIV_APP_ID="1089"

# NOWPAYMENTS CRYPTO GATEWAY (Stage 5 server-side only)
NOWPAYMENTS_API_KEY="your-nowpayments-api-key-here"
NOWPAYMENTS_IPN_SECRET="your-nowpayments-ipn-secret-here"

# DEMO MODE (Non-negotiable Rule 1: Set to false in production)
VITE_ALLOW_DEMO="false"


