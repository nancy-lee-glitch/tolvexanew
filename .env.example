# GEMINI_API_KEY: Required for server-side Gemini AI features (if used).
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The public URL where this applet is hosted.
APP_URL="https://your-domain.vercel.app"

# DATABASE CONFIGURATION (Optional - defaults automatically to embedded storage)
# For Supabase PostgreSQL, provide your connection pooler string:
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# NOWPAYMENTS CRYPTO GATEWAY
NOWPAYMENTS_API_KEY="your_nowpayments_api_key_here"
NOWPAYMENTS_IPN_SECRET="your_nowpayments_ipn_secret_here"

# SUPABASE CLIENT CONFIGURATION
# Set in Vercel / hosting environment variables
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# JWT / SESSION SECRET
SESSION_SECRET="your_random_64_char_session_secret_here"

